{
  "manifest_version": 3,
  "name": "Tab Manager Pro",
  "version": "1.7.0",
  "description": "Tame tab chaos: auto-group tabs by site, find any tab instantly and close duplicates in one click. Private, fast, Chrome & Brave.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "sessions",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Tab Manager Pro"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "group-all-tabs": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "Group all tabs by domain"
    },
    "ungroup-all-tabs": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Ungroup all tabs"
    }
  }
}